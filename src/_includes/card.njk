<li class="card">
  <a href="{{ p.url }}">
    <img src="{{ p.data.cover }}" alt="" width="1600" height="1000" loading="lazy" />
    <span class="card-body">
      <span class="card-title">{{ p.data.title }}</span>
      <span class="card-summary">{{ p.data.summary }}</span>
      <span class="card-meta">{{ p.data.year }} &middot; {{ p.data.role }}</span>
    </span>
  </a>
</li>
